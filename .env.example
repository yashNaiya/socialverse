# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Free local agents (--mode ollama) ------------------------------------
# Must be a loopback URL; anything else is rejected so prompts stay on-device.
ECHO_OLLAMA_HOST=http://127.0.0.1:11434
ECHO_OLLAMA_MODEL=qwen2.5:3b

# --- Optional paid agents (--mode claude) ---------------------------------
# Only needed for --mode claude. Mock and ollama modes need no key and cost nothing.
ANTHROPIC_API_KEY=

# Model used for agent decisions.
ECHO_MODEL=claude-haiku-5-5

# Hard spending ceiling in USD for any single run. The CLI cannot exceed this.
ECHO_MAX_USD_HARD_CAP=2.00
